{
  /* The unit tests type-check as their own project because they run in Node, not in the browser.
     They read files off disk (the i18n inventory, a component's own source) and so need @types/node
     — which tsconfig.app.json must NOT have: the app is a browser bundle, and a `node:fs` import
     that type-checks there would only fail at runtime. Splitting them keeps `node` available to the
     tests and out of reach of the app, the same way tsconfig.e2e.json does for Playwright.

     Everything else is inherited, so the tests see the app exactly as the app is compiled — the
     translating JSX runtime included. `exclude` is reset because tsconfig.app.json excludes these
     very files; without that, this project would include nothing. */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "exclude": []
}
