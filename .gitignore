# Secrets — never commit. .env holds JWT_SECRET, POSTGRES_PASSWORD,
# CRED_ENC_KEY_V* (decrypts every device's admin password) and WORKER_SHARED_SECRET.
# Copy .env.example instead.
.env
*.env
!*.env.example
backup-network-automation
# Copies of .env are the same secrets under a name the rules above do not match: `*.env` matches
# what ENDS in .env, and `.env.bak-20260902-140505` does not. Key rotation writes exactly such a
# file (scripts/rotate-cred-key.ps1), so without this a full-file backup of every secret sits in the
# working tree waiting for the next `git add -A`.
.env.bak*
.env.*.bak
.env.local
.env.save

# curl cookie jars. Verifying a change against the running stack means
# `curl -c cookies.txt -X POST .../auth/login`, and the file that leaves behind holds a live
# session — an app auth_token, or a FortiGate ccsrftoken + APSCOOKIE for the lab firewall. Two of
# them (cookies.txt, fg.txt) were committed exactly this way and sat in the
# repository until gitleaks was pointed at it. The names are the ones SKILL.md tells people to use.
cookies.txt
fg.txt
*.cookies
cookiejar*.txt

# gitleaks report, if anyone runs the CI scan by hand
leaks.json

# Go
*.exe
*.test
*.out

# MaxMind GeoLite2 databases — ~60-70 MB each and licensed per the GeoLite2 EULA, so they are
# fetched locally (scripts/download-geoip.sh), never committed. The directory + its README stay.
backend/geoip/*.mmdb

# Node
node_modules/
dist/

# Editors / OS
.DS_Store
Thumbs.db

# TLS for the LAN deployment — the private keys must never be committed.
# Regenerate with scripts/gen-lan-cert.sh; the CA cert (ca.crt) is the only file
# meant to leave this machine, and it goes to the client PCs, not to git.
frontend/certs/*
!frontend/certs/.gitkeep
*.key
*.crt
*.srl

# Reference material, not part of this project. `web_example/` is a sample system the author
# brought in to show what a future build should look like — it is nobody's dependency here and
# must not enter the history.
web_example/


# Coverage profiles: generated by the `coverage` CI job and by a local run of the same command.
# The RATCHET (backend/test/coverage-budget.json) is committed; the profile it is read from is not.
coverage.out

